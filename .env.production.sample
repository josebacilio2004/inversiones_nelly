# ====================================================================
# INVERSIONES NELLY S.A.C. - VARIABLES DE ENTORNO (PRODUCCIÓN)
# ====================================================================

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
APP_URL=https://inversionesnelly.pe

NEXT_PUBLIC_COMPANY_NAME="Inversiones Nelly S.A.C."
NEXT_PUBLIC_RUC="20608945123"
NEXT_PUBLIC_SUPPORT_PHONE="(01) 719-8420"
NEXT_PUBLIC_SUPPORT_WHATSAPP="987654321"
NEXT_PUBLIC_SUPPORT_EMAIL="cotizaciones@inversionesnelly.pe"

# Base de Datos (Conexión interna entre contenedores Docker)
DB_USER=nelly_prod_user
DB_PASSWORD=CHANGE_THIS_IN_PRODUCTION_COMPLEX_PASSWORD_2026!
DB_NAME=inversiones_nelly_db
DATABASE_URL="postgresql://nelly_prod_user:CHANGE_THIS_IN_PRODUCTION_COMPLEX_PASSWORD_2026!@postgres_db:5432/inversiones_nelly_db?schema=public"

# Redis Interno en Red Docker
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD_2026!
REDIS_URL="redis://:CHANGE_THIS_REDIS_PASSWORD_2026!@redis_cache:6379"

# API SUNAT en Producción
SUNAT_API_TOKEN="live_prod_token_from_reniec_sunat_provider"
SUNAT_API_ENDPOINT="https://api.apis.net.pe/v2/sunat/ruc"

# Claves Criptográficas de Producción
NEXTAUTH_SECRET="REPLACE_WITH_OPENSSL_RAND_BASE64_64_CHARACTERS"
NEXTAUTH_URL="https://inversionesnelly.pe"
